---
import "../styles/tokens.css";
import "../styles/themes.css";
import "../styles/base.css";
import "../styles/shell.css";
import "../styles/home.css";
import "../styles/mods.css";
import "../styles/assets.css";
import "../styles/pages.css";
import TitleBar from "../components/TitleBar.astro";
import Sidebar from "../components/Sidebar.astro";
import StatusBar from "../components/StatusBar.astro";
import WinterFx from "../components/WinterFx.astro";
import HomeView from "../components/views/Home.astro";
import ModsView from "../components/views/Mods.astro";
import AssetsView from "../components/views/Assets.astro";
import BrowseView from "../components/views/Browse.astro";
import RegionsView from "../components/views/Regions.astro";
import NewsView from "../components/views/News.astro";
import AccountView from "../components/views/Account.astro";
import SettingsView from "../components/views/Settings.astro";
import UpdatesView from "../components/views/Updates.astro";
import AboutView from "../components/views/About.astro";
---

<!doctype html>
<html lang="en" data-theme="aurora">
  <head>
    <script is:inline>
      (() => {
        // Apply the last chosen preset before CSS paints. Python remains the
        // authoritative source; app.ts reconciles this once the bridge is up.
        const root = document.documentElement;
        // Keep the background relative to index.html (works from file:// too).
        root.style.setProperty("--winter-bg-image", "url('./winter-bg.svg')");
        const legacy = { dark: "aurora", light: "aurora-light" };
        const eventThemes = { winter: "winter" };
        const valid = [
          "aurora", "aurora-light", "forest", "violet", "ember", "slate",
          "mono", "winter",
        ];
        const storageOff = (key) => {
          try {
            const value = (localStorage.getItem(key) || "").toLowerCase();
            return value === "0" || value === "false" || value === "off" || value === "no";
          } catch (_) {
            return false;
          }
        };
        try {
          const forced = (new URLSearchParams(location.search).get("event") || "")
            .toLowerCase();
          let id = "";
          if (eventThemes[forced]) {
            // The launcher forces the seasonal preset on every launch.
            id = eventThemes[forced];
          } else {
            const saved = localStorage.getItem("cl-web-theme");
            id = saved ? (legacy[saved] || saved) : "";
          }
          if (valid.includes(id)) root.dataset.theme = id;

          // "auto" effects follow the Winter preset; an explicit off wins.
          if (id === "winter" && !storageOff("cl-winter-fx")) {
            root.dataset.winter = "1";
            if (!storageOff("cl-winter-bg")) root.dataset.winterBg = "1";
          }
        } catch (_) {
          /* localStorage can be unavailable in hardened webviews. */
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>CrewLauncher</title>
  </head>
  <body>
    <!-- icon sprite (feather-style, hand trimmed) -->
    <svg class="sprite" aria-hidden="true">
      <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 10.2 12 3l9 7.2" /><path d="M5.5 9.4V21h13V9.4" /><path d="M9.5 21v-6h5v6" /></symbol>
      <symbol id="i-puzzle" viewBox="0 0 24 24"><path d="M10 3.6a2 2 0 1 1 4 0c0 .8.7 1.5 1.5 1.5H17a1 1 0 0 1 1 1v1.5c0 .8.7 1.5 1.5 1.5a2 2 0 1 1 0 4c-.8 0-1.5.7-1.5 1.5V17a1 1 0 0 1-1 1h-1.5c-.8 0-1.5.7-1.5 1.5a2 2 0 1 1-4 0c0-.8-.7-1.5-1.5-1.5H6a1 1 0 0 1-1-1v-1.5c0-.8-.7-1.5-1.5-1.5a2 2 0 1 1 0-4c.8 0 1.5-.7 1.5-1.5V6a1 1 0 0 1 1-1h1.5C9.3 5.1 10 4.4 10 3.6Z" /></symbol>
      <symbol id="i-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5Z" /></symbol>
      <symbol id="i-layers" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5Z" /><path d="m3 12 9 5 9-5" /><path d="m3 16 9 5 9-5" /></symbol>
      <symbol id="i-map" viewBox="0 0 24 24"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.6" /></symbol>
      <symbol id="i-news" viewBox="0 0 24 24"><rect x="3" y="5" width="14" height="14" rx="2" /><path d="M7 9h6M7 13h6M7 17h4" /><path d="M17 9h4v8a2 2 0 0 1-4 0Z" /></symbol>
      <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c0-3.3 3.1-5.5 7-5.5s7 2.2 7 5.5" /></symbol>
      <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2" /><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1A1.6 1.6 0 0 0 9 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.6 1.6 0 0 0 4.6 9a1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1Z" /></symbol>
      <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></symbol>
      <symbol id="i-play" viewBox="0 0 24 24"><path d="M7.5 4.8 19 12 7.5 19.2Z" /></symbol>
      <symbol id="i-stop" viewBox="0 0 24 24"><rect x="6.5" y="6.5" width="11" height="11" rx="2.5" /></symbol>
      <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12" /><path d="m7.5 10.5 4.5 4.5 4.5-4.5" /><path d="M4 20h16" /></symbol>
      <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 3 17Z" /></symbol>
      <symbol id="i-tool" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9Z" /></symbol>
      <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.3-5.6" /><path d="M20 4v5h-5" /></symbol>
      <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" /></symbol>
      <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></symbol>
      <symbol id="i-minus" viewBox="0 0 24 24"><path d="M6 12h12" /></symbol>
      <symbol id="i-maximize" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="1.5" /></symbol>
      <symbol id="i-image" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="1.8" /><path d="m4 17 5-4.5 4 3.5 3-2.5 4 3.5" /></symbol>
      <symbol id="i-edit" viewBox="0 0 24 24"><path d="M4 20h4l10-10-4-4L4 16Z" /><path d="m14 6 4 4" /></symbol>
      <symbol id="i-external" viewBox="0 0 24 24"><path d="M14 4h6v6" /><path d="M20 4 11 13" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></symbol>
      <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 4 2.5 20h19Z" /><path d="M12 10v4M12 17h.01" /></symbol>
      <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 13 4.5 4.5L19 7" /></symbol>
      <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
      <symbol id="i-gamepad" viewBox="0 0 24 24"><rect x="2.5" y="7.5" width="19" height="9.5" rx="4.5" /><path d="M7 11v3M5.5 12.5h3" /><circle cx="16" cy="11.5" r="1" /><circle cx="18" cy="14" r="1" /></symbol>
      <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4.5 6v6c0 4.5 3.1 7.9 7.5 9 4.4-1.1 7.5-4.5 7.5-9V6Z" /><path d="m9 12 2 2 4-4" /></symbol>
      <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5.2l3.2 2" /></symbol>
    </svg>

    <div class="shell" id="shell">
      <TitleBar />
      <div class="shell-body">
        <Sidebar />
        <main class="content" id="content">
          <HomeView />
          <ModsView />
          <AssetsView />
          <BrowseView />
          <RegionsView />
          <NewsView />
          <AccountView />
          <SettingsView />
          <UpdatesView />
          <AboutView />
        </main>
      </div>
      <StatusBar />
    </div>

    <WinterFx />
    <div class="toasts" id="toasts"></div>
    <div id="modal-root"></div>

    <script>
      import "../scripts/app";
    </script>
  </body>
</html>

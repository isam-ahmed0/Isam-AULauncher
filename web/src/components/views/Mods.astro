---
---
<section class="view" data-view="mods" id="view-mods">
  <div class="page-head">
    <div>
      <h1>Mods</h1>
      <p class="sub">Manage plugins in the active profile.</p>
    </div>
    <div class="head-actions">
      <button class="btn" id="mods-scan">
        <svg class="icon sm"><use href="#i-shield" /></svg>
        Scan issues
      </button>
      <button class="btn primary" id="mods-import">
        <svg class="icon sm"><use href="#i-plus" /></svg>
        Import mods
      </button>
    </div>
  </div>

  <div class="profile-bar">
    <span class="label">Profile</span>
    <select class="field" id="profile-select"></select>
    <button class="btn primary" id="profile-activate" hidden>Activate</button>
    <button class="btn" id="profile-new">New</button>
    <button class="btn icon-btn" id="profile-rename" title="Rename profile">
      <svg class="icon sm"><use href="#i-edit" /></svg>
    </button>
    <button class="btn icon-btn danger" id="profile-delete" title="Delete profile">
      <svg class="icon sm"><use href="#i-x" /></svg>
    </button>
    <div class="spacer"></div>
    <span class="pill" id="mods-count">— mods</span>
  </div>

  <div class="notice danger" id="mods-issues-notice">
    <svg class="icon"><use href="#i-alert" /></svg>
    <span class="grow" id="mods-issues-text"></span>
  </div>

  <section class="card">
    <div class="card-title">
      <svg class="icon sm"><use href="#i-puzzle" /></svg>
      Installed plugins
      <span class="pill" id="mods-enabled" style="margin-left: auto;">0 enabled</span>
    </div>
    <div class="mod-table" id="mod-list">
      <div class="empty" style="padding: 34px 20px;">
        <span class="badge-icon"><svg class="icon lg"><use href="#i-puzzle" /></svg></span>
        <h3>No plugins yet</h3>
        <p>Import a DLL or browse the catalog to add your first mod.</p>
        <button class="btn primary" id="mods-import-empty">Import mods</button>
      </div>
    </div>
  </section>
</section>

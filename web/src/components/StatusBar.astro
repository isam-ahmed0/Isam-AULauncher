---
---
<footer class="statusbar">
  <div class="item">
    <span class="dot" id="sb-dot"></span>
    <span class="sb-text" id="sb-status">Starting…</span>
  </div>
  <div class="item grow">
    <span class="sb-text" id="sb-detail"></span>
  </div>
  <div class="item" id="sb-update-wrap" hidden>
    <span class="pill accent" id="sb-update"></span>
  </div>
  <div class="item" title="Detected GPU">
    <svg class="icon sm"><use href="#i-gamepad" /></svg>
    <span class="sb-text" id="sb-gpu">—</span>
  </div>
  <div class="item" title="Launcher version">
    <span class="sb-text" id="sb-version"></span>
  </div>
</footer>
